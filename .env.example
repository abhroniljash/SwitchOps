# ================================================================
# SwitchOps Configuration Template
# ================================================================

# Runtime Mode: 'live' or 'simulation'
SWITCHOPS_MODE=live

# Switch Core Gateway (sandbox-quantum/switch backend)
SWITCH_GATEWAY_URL=http://localhost:8000
SWITCH_API_KEY=switch_test_key_sample
SWITCH_WEBHOOK_SECRET=switch_webhook_hmac_secret_sample

# Security & Dashboard API Authentication (Optional for localhost dev)
DASHBOARD_API_KEY=

# SQLite Database Persistence
SQLITE_DB_PATH=switchops.db

# Monitoring Integrations
SENTRY_WEBHOOK_SECRET=
CLOUDWATCH_ROLE_ARN=

# Foundation Model AI Agent (gemini, openai, or anthropic)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub GitOps Automation
GITHUB_TOKEN=ghp_your_github_token
GITHUB_REPOSITORY=your-org/payments-service
GITHUB_BASE_BRANCH=main

# Wispr Flow Voice Integration (Bonus Track)
WISPR_FLOW_API_KEY=
WISPR_AUTO_CONFIRM_VOICE=true

# Server Settings
HOST=127.0.0.1
PORT=5000
DEBUG=false
