# ================================================================
# SwitchOps Configuration
# ================================================================

# Mode: 'simulation' (default, runs out of the box with zero external deps)
# or 'live' (connects to real Switch Core, Slack, Discord, and LLM)
SWITCHOPS_MODE=simulation

# Switch Core Gateway (sandbox-quantum/switch backend)
SWITCH_GATEWAY_URL=http://localhost:8000
SWITCH_API_KEY=switch_test_key_sample

# Chat Platform Webhooks & Tokens
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# LLM Provider (Optional if in simulation mode)
# Supported: gemini, openai, anthropic, or mock
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub Automation
GITHUB_TOKEN=ghp_your_github_token
GITHUB_REPOSITORY=your-org/payments-service

# Wispr Flow Voice Integration
WISPR_FLOW_API_KEY=
WISPR_AUTO_CONFIRM_VOICE=true

# Server Settings
PORT=5000
HOST=0.0.0.0
DEBUG=true
